{
  "name": "sezo-audio-engine",
  "version": "0.0.20",
  "description": "Cross-platform Expo module for the Sezo Audio Engine with iOS implementation and background playback.",
  "license": "MIT",
  "author": "Sezo",
  "homepage": "https://sepzie.github.io/SezoAudioEngine/expo/overview/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sepzie/SezoAudioEngine.git",
    "directory": "packages/expo-module"
  },
  "bugs": {
    "url": "https://github.com/Sepzie/SezoAudioEngine/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "audio",
    "android",
    "ios",
    "multitrack",
    "playback",
    "recording",
    "sezo"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "android/src",
    "android/cpp",
    "android/build.gradle",
    "android/settings.gradle",
    "ios/AudioEngine",
    "ios/ExpoAudioEngine.podspec",
    "ios/ExpoAudioEngineModule.swift",
    "dist",
    "expo-module.config.json",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "rm -rf ios/build",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "expo": ">=51.0.0 <59.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  }
}
